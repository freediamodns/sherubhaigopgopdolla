DISCORD_TOKEN=PUT_BOT_TOKEN_HERE
PREFIX=<
ADMIN_IDS=PUT_YOUR_DISCORD_USER_ID_HERE
MAX_RAM_GB=32
MAX_CPU_CORES=6
MAX_DISK_GB=80
DOCKER_IMAGE=kts-ubuntu-systemd:24.04
DATA_DIR=/opt/kts-vps-bot/data

# Private network for VPS containers. Every VPS gets its own unique address.
VPS_NETWORK=kts-vps-net
VPS_SUBNET=172.30.0.0/16
VPS_GATEWAY=172.30.0.1

# This is a private LAN IP only, not a public IPv4 address.

# Guest resource display values are injected per VPS by the bot.
